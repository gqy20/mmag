{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmag.ai/skills/project/output/1.0.0",
  "x-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "summary",
    "status",
    "milestones",
    "tasks",
    "risks",
    "decisions",
    "open_questions",
    "next_actions"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "status": {"enum": ["planning", "on_track", "at_risk", "blocked", "unknown"]},
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "due", "status", "exit_criteria"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "due": {"type": ["string", "null"]},
          "status": {"enum": ["not_started", "in_progress", "done", "blocked", "unknown"]},
          "exit_criteria": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "owner", "due", "status", "dependencies"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "owner": {"type": ["string", "null"]},
          "due": {"type": ["string", "null"]},
          "status": {"enum": ["todo", "doing", "done", "blocked", "unknown"]},
          "dependencies": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "impact", "mitigation", "owner"],
        "properties": {
          "risk": {"type": "string", "minLength": 1},
          "impact": {"enum": ["high", "medium", "low"]},
          "mitigation": {"type": "string"},
          "owner": {"type": ["string", "null"]}
        }
      }
    },
    "decisions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}}
  }
}
