{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmag.ai/agents/ppt/output/1.0.0",
  "x-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "agent", "result", "artifacts", "sources", "warnings", "usage", "provenance"],
  "properties": {
    "status": {"const": "succeeded"},
    "agent": {"const": "ppt"},
    "result": {"$ref": "#/$defs/result"},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "sources": {"type": "array"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "usage": {"$ref": "#/$defs/usage"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "audience", "objective", "narrative", "slides", "delivery"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "narrative": {"type": "string", "minLength": 1},
        "slides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "title", "purpose", "body", "visual", "source_refs", "notes"],
            "properties": {
              "number": {"type": "integer", "minimum": 1},
              "title": {"type": "string", "minLength": 1},
              "purpose": {"type": "string", "minLength": 1},
              "body": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "visual": {"type": ["string", "null"]},
              "source_refs": {"type": "array", "items": {"type": "string"}},
              "notes": {"type": "string"}
            }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "filename", "status"],
          "properties": {
            "format": {"enum": ["markdown", "json"]},
            "filename": {"type": ["string", "null"]},
            "status": {"enum": ["not_requested", "pending_approval", "delivered"]}
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_calls", "tool_calls", "cost_usd"],
      "properties": {
        "model_calls": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "required": [
        "agent_name",
        "agent_spec_version",
        "package_hash",
        "prompt_id",
        "prompt_version",
        "prompt_hash",
        "input_schema_version",
        "output_schema_version",
        "policy_version",
        "model_policy_version"
      ]
    }
  }
}
