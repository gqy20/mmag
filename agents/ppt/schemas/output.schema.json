{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmag.ai/agents/ppt/output/2.0.0",
  "x-version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "agent", "result", "artifacts", "sources", "warnings", "usage", "provenance"],
  "properties": {
    "status": {"const": "succeeded"},
    "agent": {"const": "ppt"},
    "result": {"$ref": "#/$defs/result"},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "sources": {"type": "array"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "usage": {"$ref": "#/$defs/usage"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "artifactRef": {"type": "string", "pattern": "^artifact://[a-f0-9]{32}$"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "audience", "objective", "narrative", "source", "theme_ref", "slide_count", "bundle", "delivery"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "narrative": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1, "maxLength": 200000},
        "theme_ref": {"const": "corp@1.0.0"},
        "slide_count": {"type": "integer", "minimum": 1, "maximum": 40},
        "bundle": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_ref", "pptx_ref", "preview_refs", "editable_ratio"],
              "properties": {
                "source_ref": {"$ref": "#/$defs/artifactRef"},
                "pptx_ref": {"$ref": "#/$defs/artifactRef"},
                "preview_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
                "editable_ratio": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          ]
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"enum": ["not_requested", "pending_approval", "delivered"]}}
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_calls", "tool_calls", "cost_usd"],
      "properties": {
        "model_calls": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "required": ["agent_name", "agent_spec_version", "package_hash", "prompt_id", "prompt_version", "prompt_hash", "input_schema_version", "output_schema_version", "policy_version", "model_policy_version"]
    }
  }
}
