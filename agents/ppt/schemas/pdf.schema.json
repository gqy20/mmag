{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmag.ai/agents/ppt/pdf/1.0.0",
  "x-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "ref",
    "filename",
    "media_type",
    "sha256",
    "size_bytes",
    "provenance"
  ],
  "properties": {
    "kind": {"const": "presentation_pdf"},
    "schema_version": {"const": "1.0.0"},
    "ref": {"type": "string", "pattern": "^artifact://[a-f0-9]{32}$"},
    "filename": {"const": "deck.pdf"},
    "media_type": {"const": "application/pdf"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "required": [
        "execution_profile",
        "execution_profile_hash",
        "execution_command",
        "execution_script_hash",
        "execution_executable_hash",
        "execution_argv_hash"
      ]
    }
  }
}
