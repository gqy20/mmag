# mmag 环境配置模板：复制为 .env 后填写实际值。

# Mattermost
MM_URL=https://your-mattermost-server
MM_TOKEN=your-bot-token
# 部署后保持稳定；不能使用 Team ID 代替企业租户边界。
MM_INSTALLATION_ID=corp-mm-prod
MM_TENANT_ID=corp
MM_TEAM_ID=
MM_CHANNEL_ID=

# 显式外部评估。普通运行和默认 pytest 不读取这些账号。
MMAG_E2E_ENABLED=0
MM_E2E_BOT_USERNAME=
MM_USERNAME=
MM_PASSWORD=
MM_APPROVER_USERNAME=
MM_APPROVER_PASSWORD=
MM_UNAUTHORIZED_USERNAME=
MM_UNAUTHORIZED_PASSWORD=
MM_ACK_MESSAGE=get
MM_RESPONSE_MAX_CHARS=12000
MM_STREAM_ENABLED=true
MM_STREAM_UPDATE_INTERVAL_MS=750
MM_STREAM_MIN_CHARS=80

# 可选 Mattermost 交互回调。公网 URL 必须为 HTTPS；本地监听建议放在反向代理后。
MM_ACTION_CALLBACK_URL=
MM_ACTION_SIGNING_SECRET=
MM_ACTION_LISTEN_HOST=127.0.0.1
MM_ACTION_LISTEN_PORT=8787
MM_ACTION_TOKEN_TTL_SECONDS=600
MM_SLASH_COMMAND_TOKEN=

# Anthropic 或兼容接口
ANTHROPIC_API_KEY=sk-your-api-key
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Model Policy 的平台级 class 映射；Agent YAML 不能直接填写模型名。
ANTHROPIC_LOW_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MEDIUM_MODEL=claude-sonnet-4-20250514

# Agent Package / Policy
AGENT_PACKAGES_PATH=./agents
SKILL_PACKAGES_PATH=./skills
POLICIES_PATH=./policies
MODEL_POLICIES_PATH=./model-policies
EXECUTION_PROFILES_PATH=./execution-profiles
EXECUTION_RUNTIME_ROOT=.venv
EXECUTION_WORKSPACE_PATH=/tmp/mmag-execution
EXECUTION_WORKSPACE_RETENTION_SECONDS=3600
# 仅用于隔离环境内的可信 Demo；完整 Shell 不是生产 Sandbox。
MMAG_ALLOW_UNSAFE_LOCAL_EXEC=false
ARTIFACT_STORE_PATH=./artifacts
MODEL_BUDGET_USD=100
RUNTIME_DEADLINE_SECONDS=120
MAX_TOOL_ROUNDS=10

# 消息调度
PIPELINE_MAX_CONCURRENCY=8
PIPELINE_MAX_PENDING=256
MAX_CONTEXT_MESSAGES=100
MAX_CONTEXT_CHARS=30000
TYPING_DELAY_MIN=1
TYPING_DELAY_MAX=3

# 存储、摘要与日志
MEMORY_DB_PATH=./agent_memory.db
CHECKPOINT_DB_PATH=./agent_checkpoints.db
MEMORY_SUMMARY_INTERVAL=100
MEMORY_CONTEXT_WINDOW=100
LOG_LEVEL=INFO
# json 用于生产采集；text 用于本地开发。
LOG_FORMAT=text
# 留空可关闭本地文件，只保留 stdout。
LOG_DIR=logs
LOG_RETENTION_DAYS=30
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=5

# 附件
MAX_IMAGES_PER_MSG=4
MAX_IMAGE_BYTES=5242880
MAX_TEXT_ATTACHMENT_CHARS=50000

# MCP：统一 Server、启停和平台工具清单；Agent 权限仍在各自 agent.yml 中声明。
MCP_CONFIG_PATH=./.mcp.json

# 调试工具 (scripts/debug/)，复制此块到 .env.debug
# MM_URL 和 MM_TOKEN 从 .env 继承；此处只需测试账号和频道 ID
# MM_USERNAME=test
# MM_PASSWORD=
# DEBUG_BUGS_CHANNEL_ID=
# DEBUG_TEST_CHANNEL_ID=
