# ===========================================
# mmag 环境配置模板
# 复制此文件为 .env 并填写实际值: cp .env.example .env
# ===========================================

# ---- Mattermost 连接 ----
MM_URL=https://your-mattermost-server
MM_TOKEN=your-bot-token
MM_BOT_USER_ID=             # 可选，Bot 用户 ID（留空自动获取）
MM_TEAM_ID=                 # 可选，Team ID（留空监听所有 Team）
MM_CHANNEL_ID=              # 可选，Channel ID（留空监听 Team 下所有频道）

# ---- LLM 配置（支持 Anthropic / StepFun 兼容接口）----
ANTHROPIC_API_KEY=sk-your-api-key
ANTHROPIC_BASE_URL=          # 留空 = 官方 API (api.anthropic.com)
                              # 或填 StepFun 兼容地址，如 https://api.stepfun.com/step_plan
ANTHROPIC_MODEL=step-3.7-flash

# ---- Bot 身份 ----
BOT_NAME=小智
BOT_DISPLAY_NAME=小智

# ---- 行为参数 ----
LISTEN_PROBABILITY=0.15      # 主动旁听概率 0~1（0=只回@和DM, 1=每条都回）
MAX_CONTEXT_MESSAGES=100     # LLM 上下文窗口消息数
MAX_CONTEXT_CHARS=30000       # LLM 上下文窗口总字符上限 (≈15k token,超限从旧消息裁剪)
TYPING_DELAY_MIN=1            # 模拟打字最短延迟(秒)
TYPING_DELAY_MAX=3            # 模拟打字最长延迟(秒)

# ---- 存储与日志 ----
MEMORY_DB_PATH=./agent_memory.db
LOG_LEVEL=INFO                # DEBUG / INFO / WARNING / ERROR
LOG_DIR=logs                 # 日志目录（留空则不写文件）
                              # 文件按启动时间戳命名: mmag-2026-06-11_103549.log
LOG_RETENTION_DAYS=30        # 日志文件保留天数（0 = 不自动清理）

# ---- 记忆系统 (Layer 1 + Layer 2) ----
MEMORY_CACHE_MAX=100000      # 每频道缓存消息上限 (约70MB)
MEMORY_SUMMARY_INTERVAL=100  # 每 N 条消息触发一次 LLM 摘要 (原始消息保留)
MEMORY_COMPACTION_KEEP=80000 # 超限清理后保留条数 (80%)
MEMORY_SUMMARY_BATCH=50      # LLM 摘要每批处理的消息数
MEMORY_CONTEXT_WINDOW=100    # 摘要时注入的前序消息数（保持上下文连贯）

# ---- 多模态 (图片附件) ----
MAX_IMAGES_PER_MSG=4         # 单条消息最多喂多少张图给 LLM (1 张 ≈ 1500 token)
MAX_IMAGE_BYTES=5242880      # 单张图片字节上限 (默认 5MB),超过会跳过

# ---- Agent Loop ----
MAX_TOOL_ROUNDS=10           # Agentic 工具调用最大轮数 (每轮 = 1 次 LLM + 多次工具 + 1 次结果回填)
                            # 调高 → 复杂任务可拆更多步; 调低 → 快速失败收尾
                            # 单次请求耗时和 token 随轮数线性增加

# ---- MCP 外部工具 (Model Context Protocol) ----
MCP_CONFIG_PATH=              # .mcp.json 路径（留空 = 项目根目录 .mcp.json）
                              # 配置文件格式同 Claude Code，支持 stdio/http 传输
                              # 工具注册为 mcp_{server}_{tool} 格式
