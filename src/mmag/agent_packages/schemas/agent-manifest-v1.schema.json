{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmag.ai/schemas/agent-manifest-v1.schema.json",
  "title": "MMAG Agent Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "mmag.ai/v1"},
    "kind": {"const": "ManagedAgent"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routing", "accepted_intents", "input_schema_ref", "result_schema_ref",
        "runtime", "capabilities", "skills", "context", "policy_ref", "model_policy_ref",
        "budget", "artifacts"
      ],
      "properties": {
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "priority", "keywords", "requires_url", "scopes"],
          "properties": {
            "default": {"type": "boolean"},
            "priority": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "keywords": {"$ref": "#/$defs/stringArray"},
            "requires_url": {"type": "boolean"},
            "scopes": {"$ref": "#/$defs/nonEmptyStringArray"}
          }
        },
        "accepted_intents": {"$ref": "#/$defs/nonEmptyStringArray"},
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system_ref", "required_variables"],
          "properties": {
            "system_ref": {"$ref": "#/$defs/safeRef"},
            "required_variables": {"$ref": "#/$defs/nonEmptyStringArray"}
          }
        },
        "input_schema_ref": {"$ref": "#/$defs/safeRef"},
        "result_schema_ref": {"$ref": "#/$defs/safeRef"},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "max_turns", "timeout_seconds", "retry"],
          "properties": {
            "mode": {"enum": ["agent", "direct"], "default": "agent"},
            "capability": {"type": "string", "minLength": 1},
            "source_argument": {"type": "string", "minLength": 1},
            "route": {"type": "string", "minLength": 1},
            "max_turns": {"type": "integer", "minimum": 1, "maximum": 100},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "retry": {
              "type": "object",
              "additionalProperties": false,
              "required": ["max_attempts"],
              "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 3}}
            }
          },
          "allOf": [
            {
              "if": {"properties": {"mode": {"const": "direct"}}, "required": ["mode"]},
              "then": {"required": ["capability"]},
              "else": {
                "not": {
                  "anyOf": [
                    {"required": ["capability"]},
                    {"required": ["source_argument"]}
                  ]
                }
              }
            }
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow", "deny"],
          "properties": {
            "allow": {"$ref": "#/$defs/stringArray"},
            "deny": {"$ref": "#/$defs/stringArray"}
          }
        },
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow", "deny"],
          "properties": {
            "allow": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/versionedRef"}},
            "deny": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/versionedRef"}}
          }
        },
        "execution_profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow", "deny"],
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/versionedRef"}
            },
            "deny": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/versionedRef"}
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read_scopes", "write_scopes"],
          "properties": {
            "read_scopes": {"$ref": "#/$defs/stringArray"},
            "write_scopes": {"$ref": "#/$defs/stringArray"}
          }
        },
        "policy_ref": {"$ref": "#/$defs/versionedRef"},
        "model_policy_ref": {"$ref": "#/$defs/versionedRef"},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_model_calls", "max_tool_calls", "max_cost_usd"],
          "properties": {
            "max_model_calls": {"type": "integer", "minimum": 1, "maximum": 100},
            "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 1000},
            "max_cost_usd": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["produces"],
          "properties": {
            "produces": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "schema_ref"],
                "properties": {
                  "kind": {"type": "string", "minLength": 1},
                  "schema_ref": {"$ref": "#/$defs/safeRef"}
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"runtime": {"properties": {"mode": {"const": "direct"}}, "required": ["mode"]}}
          },
          "then": {"not": {"required": ["prompt"]}},
          "else": {"required": ["prompt"]}
        }
      ]
    }
  },
  "$defs": {
    "safeRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "versionedRef": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonEmptyStringArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
