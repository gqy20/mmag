{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmag.ai/schemas/agent-manifest-v1.schema.json",
  "title": "MMAG Agent Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "mmag.ai/v1"},
    "kind": {"const": "ManagedAgent"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_intents", "prompt", "input_schema_ref", "result_schema_ref",
        "runtime", "capabilities", "context", "policy_ref", "model_policy_ref",
        "budget", "artifacts"
      ],
      "properties": {
        "accepted_intents": {"$ref": "#/$defs/nonEmptyStringArray"},
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system_ref", "task_ref", "required_variables"],
          "properties": {
            "system_ref": {"$ref": "#/$defs/safeRef"},
            "task_ref": {"$ref": "#/$defs/safeRef"},
            "output_repair_ref": {"$ref": "#/$defs/safeRef"},
            "required_variables": {"$ref": "#/$defs/nonEmptyStringArray"}
          }
        },
        "input_schema_ref": {"$ref": "#/$defs/safeRef"},
        "result_schema_ref": {"$ref": "#/$defs/safeRef"},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "max_turns", "timeout_seconds", "retry"],
          "properties": {
            "route": {"type": "string", "minLength": 1},
            "max_turns": {"type": "integer", "minimum": 1, "maximum": 100},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "retry": {
              "type": "object",
              "additionalProperties": false,
              "required": ["max_attempts"],
              "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 3}}
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow", "deny"],
          "properties": {
            "allow": {"$ref": "#/$defs/stringArray"},
            "deny": {"$ref": "#/$defs/stringArray"}
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read_scopes", "write_scopes"],
          "properties": {
            "read_scopes": {"$ref": "#/$defs/stringArray"},
            "write_scopes": {"$ref": "#/$defs/stringArray"}
          }
        },
        "policy_ref": {"type": "string", "minLength": 1},
        "model_policy_ref": {"type": "string", "minLength": 1},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_model_calls", "max_tool_calls", "max_cost_usd"],
          "properties": {
            "max_model_calls": {"type": "integer", "minimum": 1, "maximum": 100},
            "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 1000},
            "max_cost_usd": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["produces"],
          "properties": {
            "produces": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "schema_ref"],
                "properties": {
                  "kind": {"type": "string", "minLength": 1},
                  "schema_ref": {"$ref": "#/$defs/safeRef"}
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "safeRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonEmptyStringArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
