{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmag.ai/evals/result/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "suite_id", "suite_version", "suite_sha256", "profile_id", "profile_version",
    "profile_sha256", "started_at", "completed_at", "passed", "cases",
    "functional_success_rate", "security_violation_count", "report_path"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^eval-"},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_version": {"type": "string", "minLength": 1},
    "suite_sha256": {"$ref": "#/$defs/hash"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "functional_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "security_violation_count": {"type": "integer", "minimum": 0},
    "report_path": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed", "expected", "actual", "severity"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "expected": {},
        "actual": {},
        "severity": {"enum": ["functional", "security"]}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "case_version", "scenario_sha256", "repetition", "passed",
        "assertions", "duration_seconds", "run_id", "root_post_id", "response_sha256",
        "response_excerpt", "error_code", "error_message"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "case_version": {"type": "string", "minLength": 1},
        "scenario_sha256": {"$ref": "#/$defs/hash"},
        "repetition": {"type": "integer", "minimum": 1},
        "passed": {"type": "boolean"},
        "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
        "duration_seconds": {"type": "number", "minimum": 0},
        "run_id": {"type": "string"},
        "root_post_id": {"type": "string"},
        "response_sha256": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
        "response_excerpt": {"type": "string"},
        "error_code": {"type": "string"},
        "error_message": {"type": "string"}
      }
    }
  }
}
