{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmag.ai/evals/suite/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "mmag.ai/eval/v1"},
    "kind": {"const": "EvaluationSuite"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "pass_policy"],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^cases/[A-Za-z0-9_./-]+\\.yml$"}
        },
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 10},
        "pass_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["functional_success_rate", "security_violation_count"],
          "properties": {
            "functional_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "security_violation_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
