{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmag.ai/evals/profile/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "mmag.ai/eval/v1"},
    "kind": {"const": "EvaluationProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "base_url_env", "channel_id_env", "actors"],
      "properties": {
        "driver": {"const": "mattermost-api"},
        "base_url_env": {"$ref": "#/$defs/env"},
        "channel_id_env": {"$ref": "#/$defs/env"},
        "bot_username_env": {"$ref": "#/$defs/env"},
        "enabled_env": {"$ref": "#/$defs/env"},
        "control_plane_db_env": {"$ref": "#/$defs/env"},
        "timeout_seconds": {"type": "number", "minimum": 5, "maximum": 1800},
        "poll_interval_seconds": {"type": "number", "minimum": 0.1, "maximum": 10},
        "actors": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["username_env", "password_env"],
            "properties": {
              "username_env": {"$ref": "#/$defs/env"},
              "password_env": {"$ref": "#/$defs/env"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}
  }
}
